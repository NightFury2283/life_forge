HTTP_ADDR=127.0.0.1:8080
HTTP_SHUTDOWN_TIMEOUT=5s
LOGGER_LEVEL=info
LOGGER_FOLDER=out/logs

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=lifeforge
POSTGRES_PASSWORD=lifeforge-local
POSTGRES_DB=lifeforge
POSTGRES_TIMEOUT=5s

# Set a random secret of at least 32 bytes for Google login.
JWT_SECRET_KEY=
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback
# Set true when using HTTPS.
COOKIE_SECURE=false
